# API: public project URL + publishable/legacy anon key. Never commit real secrets.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY

# Worker: server-only secret. NEVER expose to browser or commit to Git.
SUPABASE_SERVICE_ROLE_KEY=SET_IN_HOST_SECRET_MANAGER
WORKER_ID=openmontage-worker-1
WORKER_POLL_SECONDS=5
WORKER_LEASE_SECONDS=120

# Comma-separated exact browser origins; never use * in production.
CORS_ALLOW_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Required trusted adapter. The adapter must be installed in the worker image.
# Example: cloud_worker_plugins.openmontage:execute
OPENMONTAGE_EXECUTOR=

# Provider API credentials must be stored server-side in a secret manager.
# Do not add provider keys to this file or browser config.
